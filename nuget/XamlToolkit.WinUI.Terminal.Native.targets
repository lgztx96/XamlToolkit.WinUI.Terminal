<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <TerminalPlatform Condition="'$(Platform)' == 'Win32'">x86</TerminalPlatform>
    <TerminalPlatform Condition="'$(Platform)' != 'Win32'">$(Platform)</TerminalPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TerminalPlatform)' == ''">
    <TerminalPlatform Condition="'$(Platform)' == 'AnyCPU'"></TerminalPlatform>
  </PropertyGroup>

  <!-- WinMD metadata references -->
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\native\Microsoft.Terminal.Control.winmd">
      <Implementation>Microsoft.Terminal.Control.dll</Implementation>
    </Reference>
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\native\Microsoft.Terminal.Core.winmd" />
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\native\Microsoft.Terminal.Settings.Model.winmd">
      <Implementation>Microsoft.Terminal.Settings.Model.dll</Implementation>
    </Reference>
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\native\Microsoft.Terminal.TerminalConnection.winmd">
      <Implementation>Microsoft.Terminal.TerminalConnection.dll</Implementation>
    </Reference>
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\native\Microsoft.Terminal.UI.winmd">
      <Implementation>Microsoft.Terminal.UI.dll</Implementation>
    </Reference>
  </ItemGroup>

  <!-- Copy native DLLs + .pri resource files to output -->
  <ItemGroup Condition="'$(TerminalPlatform)' != ''">
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.Control.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.Control.pri" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.Settings.Model.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.Settings.Model.pri" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.Settings.Model.Lib.pri" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.TerminalConnection.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.TerminalConnection.pri" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.UI.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\Microsoft.Terminal.UI.pri" />
    <SDKReference Include="Microsoft.VCLibs.Desktop, Version=14.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TerminalPlatform)' != ''">
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(TerminalPlatform)\native\OpenConsole.exe">
	  <Link>OpenConsole.exe</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="TerminalWarnNoPlatform" BeforeTargets="BeforeBuild"
          Condition="'$(TerminalPlatform)' == '' and '$(TerminalWarnNoPlatform)' != 'false'">
    <Warning Code="TTL0001"
             Text="'XamlToolkit.WinUI.Terminal' native DLLs cannot be resolved because the project is building as 'AnyCPU'. Build with a specific platform (x64/x86/ARM64) or set 'TerminalWarnNoPlatform' to 'false' to suppress this warning." />
  </Target>

</Project>
