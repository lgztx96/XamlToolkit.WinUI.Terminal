<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows10.0.26100.0;net9.0-windows10.0.26100.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>XamlToolkit.WinUI.Terminal</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CsWinRTIncludes>Microsoft.Terminal.Control;Microsoft.Terminal.Core;Microsoft.Terminal.TerminalConnection</CsWinRTIncludes>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <GenerateCsWinRT>true</GenerateCsWinRT>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
	<PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260709004" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Terminal.Control">
      <HintPath>..\Microsoft.Terminal.Control\Microsoft.Terminal.Control.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
    </Reference>
    <Reference Include="Microsoft.Terminal.Core">
      <HintPath>..\Microsoft.Terminal.Control\Microsoft.Terminal.Core.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
    </Reference>
    <Reference Include="Microsoft.Terminal.Settings.Model">
      <HintPath>..\Microsoft.Terminal.Control\Microsoft.Terminal.Settings.Model.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
    </Reference>
    <Reference Include="Microsoft.Terminal.TerminalConnection">
      <HintPath>..\Microsoft.Terminal.Control\Microsoft.Terminal.TerminalConnection.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
    </Reference>
    <Reference Include="Microsoft.Terminal.UI">
      <HintPath>..\Microsoft.Terminal.Control\Microsoft.Terminal.UI.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
    </Reference>
  </ItemGroup>
</Project>
